%% Рисунок 2.3 — UML-диаграмма развёртывания прототипа (уточнённая схема, v2)
graph LR
  %% Styling (kept conservative to match existing exported figures)
  classDef layer fill:#F7F4D7,stroke:#CDBF63,color:#2A2A2A,stroke-width:1px;
  classDef component fill:#E8EEF7,stroke:#C5CEDA,color:#2A2A2A,stroke-width:1px;
  classDef datastore fill:#ECE6FF,stroke:#B8A8E6,color:#2A2A2A,stroke-width:1px;

  subgraph dmz["Пользовательский доступ (DMZ)"]
    clientNode["Клиентский узел<br/>браузер пользователя"]
  end

  subgraph inner["Внутренний контур предприятия"]
    subgraph presentation["Слой представления"]
      webNode["Веб-узел<br/>nginx/apache2 + TLS"]
      adminNode["Админ-узел<br/>VPN/SSH доступ"]
    end

    subgraph application["Слой приложений"]
      appNode["Узел приложения<br/>PHP-FPM + Yii2 API"]
    end

    subgraph data["Слой данных"]
      dbNode["Узел БД<br/>PostgreSQL"]
    end
  end

  clientNode -->|"HTTP/HTTPS"| webNode
  adminNode -->|"SSH/HTTPS (администрирование)"| webNode
  webNode -->|"HTTP (proxy)"| appNode
  appNode -->|"TCP/5432"| dbNode

  %% Apply classes to nodes/layers
  class presentation,application,data layer
  class webNode,adminNode,appNode component
  class dbNode datastore
