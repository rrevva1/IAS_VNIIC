@startuml
title Процесс обработки заявки, связанной с техническим средством

skinparam backgroundColor #EFEFEF
skinparam defaultFontName Arial
skinparam ArrowColor #555555
skinparam activity {
  BackgroundColor #E8EEF7
  BorderColor #C5CEDA
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #C5CEDA
  FontColor #2A2A2A
  FontSize 13
}

|Пользователь|
start
:Создать заявку;
:Указать описание проблемы\nи актив (если известен);

|Система ИАС|
:Принять заявку;
:Проверить обязательные поля;

if (Данные корректны?) then (Нет)
  :Вернуть на доработку;
  |Пользователь|
  :Уточнить данные;
  |Система ИАС|
  :Повторная проверка;
endif

:Поиск актива в реестре;
if (Актив найден?) then (Да)
  :Привязать заявку\nк карточке актива;
else (Нет)
|Оператор|
  :Уточнить сведения об активе;
  |Администратор|
  :Зарегистрировать/\nактуализировать актив;
  |Система ИАС|
  :Повторная привязка актива;
endif

|Оператор|
:Категоризировать заявку;
:Назначить приоритет;
:Назначить исполнителя;

|Оператор|
:Выполнить работы по заявке;
if (Требуется эскалация?) then (Да)
  |Оператор|
  :Эскалировать заявку;
  |Оператор|
  :Повторное выполнение работ;
endif

|Система ИАС|
:Зафиксировать результат;
:Обновить историю изменений актива;
:Запись действий в журнал аудита;

repeat
  |Пользователь|
  :Проверить результат;
repeat while (Результат принят?) is (Нет)
  |Оператор|
  :Вернуть заявку в работу;
  :Доработать решение;
  |Система ИАС|
  :Зафиксировать результат;
  :Обновить историю изменений актива;
  :Запись действий в журнал аудита;
  |Пользователь|
  :Повторная проверка результата;

|Оператор|
:Закрыть заявку;
:Сформировать итоговые данные\nдля отчётности;
|Система ИАС|
:Обновить статус заявки;
stop

@enduml
