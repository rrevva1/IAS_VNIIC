@startuml
left to right direction
title Альтернативная диаграмма прецедентов для административного контура ИАС учета ТС

skinparam backgroundColor #efefef
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam actor {
  FontColor #2a2a2a
  BorderColor #8a8a8a
}
skinparam usecase {
  BackgroundColor #f7f7f7
  BorderColor #bcbcbc
  FontColor #222222
}
skinparam note {
  BackgroundColor #f6f6de
  BorderColor #b8b88f
  FontColor #2a2a2a
}

actor "Пользователь" as User
actor "Оператор" as Operator
actor "Администратор" as Admin

User -[hidden]right-> Operator
Operator -[hidden]up-> Admin

rectangle "ИАС учета технических средств" {
  usecase "Настройка политик\nхранения" as UC_StoragePolicy
  usecase "Определить правила\nархивирования" as UC_ArchiveRules
  usecase "Определить правила\nретенции" as UC_RetentionRules
  usecase "Мониторинг\nраспределения\nданных" as UC_DataMonitoring
  usecase "Сформировать отчет\nпо распределению" as UC_DistributionReport
  usecase "Анализ прогнозов\nвостребованности" as UC_DemandForecast
  usecase "Оценка трендов\nроста данных" as UC_GrowthTrends
  usecase "Ручная инициация\nмиграции" as UC_ManualMigration
  usecase "Проверка условий\nмиграции" as UC_MigrationPrecheck
  usecase "Подтверждение\nмиграции" as UC_MigrationApprove
  usecase "Контроль статуса\nмиграции" as UC_MigrationControl

  UC_StoragePolicy -[hidden]down-> UC_ArchiveRules
  UC_ArchiveRules -[hidden]down-> UC_RetentionRules
  UC_RetentionRules -[hidden]down-> UC_DataMonitoring
  UC_DataMonitoring -[hidden]down-> UC_DistributionReport
  UC_DistributionReport -[hidden]down-> UC_DemandForecast
  UC_DemandForecast -[hidden]down-> UC_GrowthTrends
  UC_GrowthTrends -[hidden]down-> UC_ManualMigration
  UC_ManualMigration -[hidden]down-> UC_MigrationPrecheck
  UC_MigrationPrecheck -[hidden]down-> UC_MigrationApprove
  UC_MigrationApprove -[hidden]down-> UC_MigrationControl
}

Admin --> UC_StoragePolicy
Admin --> UC_DataMonitoring
Admin --> UC_DemandForecast
Admin --> UC_ManualMigration
Admin --> UC_MigrationApprove

Operator --> UC_DataMonitoring
Operator --> UC_DistributionReport
Operator --> UC_DemandForecast
Operator --> UC_GrowthTrends
Operator --> UC_MigrationControl

UC_StoragePolicy .> UC_ArchiveRules : <<include>>
UC_StoragePolicy .> UC_RetentionRules : <<include>>
UC_DataMonitoring .> UC_DistributionReport : <<include>>
UC_DemandForecast .> UC_GrowthTrends : <<include>>
UC_ManualMigration .> UC_MigrationPrecheck : <<include>>
UC_ManualMigration .> UC_MigrationApprove : <<include>>
UC_ManualMigration .> UC_MigrationControl : <<include>>

Admin --|> Operator

note top of UC_DataMonitoring
Проверка прав доступа выполняется на серверной стороне
при каждой операции изменения данных.
end note
@enduml
