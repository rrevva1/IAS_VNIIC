flowchart LR
  classDef step fill:#eef6ff,stroke:#4a78c2,color:#1b2a4a,stroke-width:1px;
  classDef decision fill:#fff4e5,stroke:#c98a2e,color:#4a2a00,stroke-width:1px;
  classDef endstate fill:#eef9ef,stroke:#3f8a46,color:#123a16,stroke-width:1px;

  A["Поступление / выявление<br/>нового актива"]:::step --> B["Постановка на учёт<br/>(карточка, атрибуты, локация)"]:::step
  B --> C["Закрепление за пользователем<br/>или рабочим местом"]:::step
  C --> D["Эксплуатация"]:::step
  D --> E{"Требуется изменение<br/>состояния актива?"}:::decision

  E -->|"Да: перенос"| F["Перемещение<br/>(новая локация / подразделение)"]:::step
  F --> D

  E -->|"Да: неисправность / ТО"| G["Ремонт и обслуживание<br/>(связь с заявкой при необходимости)"]:::step
  G --> D

  E -->|"Да: вывод из эксплуатации"| H["Списание"]:::step
  H --> I["Архивирование<br/>(сохранение истории и связей)"]:::endstate

  E -->|"Нет"| D
