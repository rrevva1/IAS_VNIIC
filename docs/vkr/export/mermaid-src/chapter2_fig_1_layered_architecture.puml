@startuml
title Рисунок 2.1 — Многослойная клиент-серверная архитектура прототипа ИАС
caption Нотация: UML Component/Deployment (логический уровень)
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam ArrowColor #555555

skinparam package {
  BackgroundColor #F7F4D7
  BorderColor #CDBF63
  FontColor #2A2A2A
}
skinparam rectangle {
  BackgroundColor #E8EEF7
  BorderColor #C5CEDA
  FontColor #2A2A2A
  RoundCorner 6
}
skinparam database {
  BackgroundColor #ECE6FF
  BorderColor #B8A8E6
  FontColor #2A2A2A
}

package "Клиентский уровень" as CLIENT {
  rectangle "Веб-браузер\nAG Grid и формы" as Browser
}

package "Сервер приложений" as APP {
  rectangle "Веб-сервер\nApache/nginx + PHP-FPM" as WebServer
  rectangle "Приложение Yii2\nконтроллеры, модели, API" as YiiApp
  WebServer --> YiiApp
}

package "Слой данных" as DATA {
  database "PostgreSQL\nias_vniic / tech_accounting" as DB
}

Browser <--> WebServer : HTTP/HTTPS, JSON
YiiApp <--> DB : SQL, транзакции

@enduml
