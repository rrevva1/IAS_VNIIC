@startuml
top to bottom direction
title Роли пользователей и базовые сценарии работы ИАС учета ТС

skinparam backgroundColor #efefef
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actor {
  FontColor #2a2a2a
  BorderColor #8a8a8a
}
skinparam usecase {
  BackgroundColor #f7f7f7
  BorderColor #bcbcbc
  FontColor #222222
}
skinparam note {
  BackgroundColor #f6f6de
  BorderColor #b8b88f
  FontColor #2a2a2a
}

actor "Пользователь" as User
actor "Оператор" as Operator
actor "Администратор" as Admin

' Компоновка акторов в верхней строке для узкого portrait-формата
User -[hidden]right-> Operator
Operator -[hidden]right-> Admin

' Иерархия ролей для уменьшения количества пересекающихся линий
Admin --|> Operator

rectangle "ИАС учета технических средств" {
  usecase "Изменить статус заявки" as UC_ChangeStatus
  usecase "Обработать и маршрутизировать\nзаявку" as UC_TriageRequest
  usecase "Назначить исполнителя\n(оператора)" as UC_AssignExecutor
  usecase "Просмотреть технику\nпользователя" as UC_ViewUserAssets
  usecase "Добавить комментарий\nк заявке" as UC_AddComment
  usecase "Вести карточки активов\nи справочники" as UC_ManageAssetsRef
  usecase "Учитывать ПО и лицензии" as UC_SoftwareLicenses
  usecase "Управлять пользователями\nи ролями" as UC_ManageUsersRoles
  usecase "Импортировать данные" as UC_ImportData
  usecase "Просмотреть журнал аудита" as UC_ViewAuditLog
  usecase "Исполнить заявку" as UC_ExecuteRequest
  usecase "Создать заявку" as UC_CreateRequest
  usecase "Просмотреть свои заявки" as UC_ViewOwnRequests
  usecase "Просмотреть закрепленную\nтехнику" as UC_ViewAssignedAssets

  UC_ChangeStatus -[hidden]down-> UC_TriageRequest
  UC_TriageRequest -[hidden]down-> UC_AssignExecutor
  UC_AssignExecutor -[hidden]down-> UC_ViewUserAssets
  UC_ViewUserAssets -[hidden]down-> UC_AddComment
  UC_AddComment -[hidden]down-> UC_ManageAssetsRef
  UC_ManageAssetsRef -[hidden]down-> UC_SoftwareLicenses
  UC_SoftwareLicenses -[hidden]down-> UC_ManageUsersRoles
  UC_ManageUsersRoles -[hidden]down-> UC_ImportData
  UC_ImportData -[hidden]down-> UC_ViewAuditLog
  UC_ViewAuditLog -[hidden]down-> UC_ExecuteRequest
  UC_ExecuteRequest -[hidden]down-> UC_CreateRequest
  UC_CreateRequest -[hidden]down-> UC_ViewOwnRequests
  UC_ViewOwnRequests -[hidden]down-> UC_ViewAssignedAssets
}

' Привязка акторов сверху к своим сценариям
User --> UC_CreateRequest
User --> UC_ViewOwnRequests
User --> UC_ViewAssignedAssets

Operator --> UC_TriageRequest
Operator --> UC_AssignExecutor
Operator --> UC_ViewUserAssets
Operator --> UC_ChangeStatus
Operator --> UC_AddComment
Operator --> UC_ExecuteRequest
Operator --> UC_ManageAssetsRef : в пределах регламента

Admin --> UC_ManageUsersRoles
Admin --> UC_ManageAssetsRef
Admin --> UC_ViewAuditLog
Admin --> UC_ImportData
Admin --> UC_SoftwareLicenses
Admin --> UC_ChangeStatus
Admin --> UC_AddComment
Admin --> UC_AssignExecutor

UC_TriageRequest .> UC_AssignExecutor : <<include>>
UC_TriageRequest .> UC_ChangeStatus : <<include>>
UC_TriageRequest .> UC_AddComment : <<include>>
UC_ExecuteRequest .> UC_ChangeStatus : <<include>>
UC_ExecuteRequest .> UC_AddComment : <<include>>

note bottom
Проверка прав доступа выполняется на серверной стороне
при каждой операции изменения данных.
Исполнитель по заявке — оператор, назначенный администратором.
end note
@enduml
