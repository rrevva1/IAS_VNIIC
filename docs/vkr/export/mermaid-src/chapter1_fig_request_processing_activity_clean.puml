@startuml
title Процесс обработки заявки, связанной с техническим средством (Activity)

skinparam backgroundColor #FFFFFF
skinparam activity {
  BackgroundColor #E8EEF7
  BorderColor #C5CEDA
  FontName Arial
  FontSize 13
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #C5CEDA
}
skinparam partition {
  BorderColor #8C8C8C
  FontName Arial
  FontSize 14
}

start

partition "Пользователь" {
  :Создать заявку;
}

partition "Система ИАС" {
  :Принять заявку;
  :Проверить обязательные поля;
  if (Данные корректны?) then (Нет)
    :Вернуть на доработку;
  endif
}

partition "Пользователь" {
  if (Требуется уточнение?) then (Да)
    :Уточнить данные;
  endif
}

partition "Система ИАС" {
  if (Повторная проверка нужна?) then (Да)
    :Повторная проверка;
  endif
  :Поиск актива в реестре;
  if (Актив найден?) then (Да)
    :Привязать заявку к карточке актива;
  else (Нет)
    partition "Оператор" {
      :Уточнить сведения об активе;
    }
    partition "Администратор" {
      :Зарегистрировать/актуализировать актив;
    }
    partition "Система ИАС" {
      :Повторная привязка актива;
    }
  endif
}

partition "Оператор" {
  :Категоризировать заявку;
  :Назначить приоритет;
  :Назначить исполнителя;
  :Выполнить работы по заявке;
  if (Требуется эскалация?) then (Да)
    :Эскалировать заявку;
    :Повторное выполнение работ;
  endif
}

partition "Система ИАС" {
  :Зафиксировать результат;
  :Обновить историю изменений актива;
  :Запись действий в журнал аудита;
}

partition "Пользователь" {
  :Проверить результат;
  if (Результат принят?) then (Да)
  else (Нет)
    partition "Оператор" {
      :Вернуть заявку в работу;
      :Доработать решение;
    }
    partition "Система ИАС" {
      :Зафиксировать результат;
      :Обновить историю изменений актива;
      :Запись действий в журнал аудита;
    }
    partition "Пользователь" {
      :Проверить результат;
    }
  endif
}

partition "Оператор" {
  :Закрыть заявку;
  :Сформировать итоговые данные для отчётности;
}

partition "Система ИАС" {
  :Обновить статус заявки;
}

stop
@enduml
