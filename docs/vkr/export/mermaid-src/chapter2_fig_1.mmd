%% Рисунок 2.1 — Многослойная клиент-серверная архитектура прототипа ИАС
%% Нотация: UML Component/Deployment (адаптировано в Mermaid)
flowchart TB
  classDef layer fill:#F7F4D7,stroke:#CDBF63,color:#2A2A2A,stroke-width:1px;
  classDef component fill:#E8EEF7,stroke:#C5CEDA,color:#2A2A2A,stroke-width:1px;
  classDef datastore fill:#ECE6FF,stroke:#B8A8E6,color:#2A2A2A,stroke-width:1px;

  subgraph clientLayer["Клиентский уровень"]
    browser["Веб-браузер<br/>AG Grid и формы"]
  end

  subgraph appLayer["Сервер приложений"]
    webServer["Веб-сервер<br/>Apache/nginx + PHP-FPM"]
    yiiApp["Приложение Yii2<br/>контроллеры, модели, API"]
    webServer --> yiiApp
  end

  subgraph dataLayer["Слой данных"]
    db["PostgreSQL<br/>ias_vniic / tech_accounting"]
  end

  class clientLayer,appLayer,dataLayer layer;
  class browser,webServer,yiiApp component;
  class db datastore;

  browser <-->|"HTTP/HTTPS, JSON"| webServer
  yiiApp <-->|"SQL, транзакции"| db
